<div class="ui-tabs @Class">
    <div class="ui-tablist" role="tablist" aria-label="@Label" @onkeydown="OnKeyDown">
        @for (var i = 0; i < _tabs.Count; i++)
        {
            var index = i;
            var tab = _tabs[i];
            <button type="button" role="tab" id="@tab.TabId" class="ui-tab" aria-selected="@(index == ActiveIndex ? "true" : "false")"
                    aria-controls="@tab.PanelId" tabindex="@(index == ActiveIndex ? 0 : -1)" @onclick="() => SelectAsync(index)">
                @if (!string.IsNullOrEmpty(tab.Icon)) { <UiIcon Name="@tab.Icon" Size="16" /> }
                @tab.Title
                @if (!string.IsNullOrEmpty(tab.Badge)) { <UiBadge Small="true" Variant="UiVariant.Primary">@tab.Badge</UiBadge> }
            </button>
        }
    </div>
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private readonly List<UiTab> _tabs = new();

    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>One or more <c>UiTab</c> elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal bool IsActive(UiTab tab) => _tabs.IndexOf(tab) == ActiveIndex;

    internal void Register(UiTab tab)
    {
        _tabs.Add(tab);
        InvokeAsync(StateHasChanged);
    }

    internal void Unregister(UiTab tab)
    {
        _tabs.Remove(tab);
        InvokeAsync(StateHasChanged);
    }

    private async Task SelectAsync(int index)
    {
        if (index == ActiveIndex || index < 0 || index >= _tabs.Count) return;
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
        foreach (var t in _tabs) t.Refresh();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_tabs.Count == 0) return;
        var next = e.Key switch
        {
            "ArrowRight" => (ActiveIndex + 1) % _tabs.Count,
            "ArrowLeft" => (ActiveIndex - 1 + _tabs.Count) % _tabs.Count,
            "Home" => 0,
            "End" => _tabs.Count - 1,
            _ => -1
        };
        if (next >= 0) await SelectAsync(next);
    }
}
