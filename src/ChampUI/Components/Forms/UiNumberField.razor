@using System.Globalization
<div class="ui-field @Class">
    @if (!string.IsNullOrEmpty(Label)) { <label class="ui-field__label" for="@_id">@Label</label> }
    <div class="ui-number">
        <button type="button" class="ui-number__btn" aria-label="@DecreaseLabel" disabled="@(Disabled || (Min.HasValue && Value <= Min))" @onclick="() => StepAsync(-1)"><UiIcon Name="minus" Size="16" /></button>
        <div class="ui-input @(Disabled ? "ui-input--disabled" : null)">
            <input id="@_id" type="text" inputmode="decimal" value="@Display" disabled="@Disabled" @onchange="OnChange" />
        </div>
        <button type="button" class="ui-number__btn" aria-label="@IncreaseLabel" disabled="@(Disabled || (Max.HasValue && Value >= Max))" @onclick="() => StepAsync(1)"><UiIcon Name="plus" Size="16" /></button>
    </div>
    @if (!string.IsNullOrEmpty(HelpText)) { <span class="ui-field__help">@HelpText</span> }
</div>

@code {
    private readonly string _id = "nf-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public double? Value { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string DecreaseLabel { get; set; } = "Decrease";
    [Parameter] public string IncreaseLabel { get; set; } = "Increase";
    [Parameter] public string? Class { get; set; }

    private string Display => Value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";

    private double Clamp(double v)
    {
        if (Min.HasValue) v = Math.Max(Min.Value, v);
        if (Max.HasValue) v = Math.Min(Max.Value, v);
        return v;
    }

    private async Task SetAsync(double? v)
    {
        Value = v.HasValue ? Clamp(Math.Round(v.Value, 6)) : null;
        await ValueChanged.InvokeAsync(Value);
    }

    private Task StepAsync(int dir) => SetAsync((Value ?? 0) + dir * Step);

    private async Task OnChange(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text)) { await SetAsync(null); return; }
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)) await SetAsync(parsed);
        else await SetAsync(Value); // revert invalid input
    }
}
