@typeparam TItem
@implements IDisposable

@using ChampUI.Core.Interfaces
@using ChampUI.Core.Models
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Web.Virtualization

@{
    // B-03: Determine if virtualization is active
    var pageRows = VirtualProvider == null ? GetRenderRows(_pageItems) : null;
    var isVirtualized = VirtualProvider != null || VirtualizationMode == UiDataGridVirtualization.Enabled;
    var virtualizedClass = isVirtualized ? "ui-grid--virtualized" : null;
    var scrollClass = isVirtualized ? "ui-grid__scroll--virtualized" : "ui-grid__scroll";
    
    // B-03: Build inline styles for CSS variables
    var inlineStyle = "";
    if (isVirtualized)
    {
        inlineStyle = $"--ui-virtual-row-height: {VirtualRowHeight}px;";
        if (!string.IsNullOrWhiteSpace(VirtualViewportHeight))
        {
            inlineStyle += $" --ui-virtual-viewport-height: {VirtualViewportHeight};";
        }
    }
}

<div class="ui-grid @virtualizedClass @(OnRowClick.HasDelegate ? "ui-grid--clickable" : null) @(EditMode != UiDataGridEditMode.None ? "ui-grid--editable" : null) @Class"
     role="@(ServerProvider != null ? "region" : null)" aria-busy="@(Loading ? "true" : null)"
     style="@inlineStyle"  >

    <CascadingValue Value="this" IsFixed="true">@Columns</CascadingValue>

    @* ───────────────────────────── Toolbar ───────────────────────────── *@
    @if (Searchable || Toolbar != null || Selectable || _columns.Any(c => c.Filterable) || CanExport)
    {
        <div class="ui-grid__toolbar">
            @if (Searchable)
            {
                <div class="ui-grid__search">
                    <UiTextField Icon="search" Type="search" Small="true" Placeholder="@SearchPlaceholder"
                                 Value="@_search" ValueChanged="OnSearchChangedAsync"
                                 aria-label="@SearchPlaceholder" />
                </div>
            }
            @Toolbar
            <span class="ui-grid__toolbar-spacer"></span>

            @* Column visibility button *@
            @if (ShowColumnToggle && _columns.Count > 0)
            {
                <div class="ui-grid__col-toggle ui-dropdown @(_colToggleOpen ? "is-open" : null)">
                    <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm ui-grid__col-toggle-btn"
                            @onclick="() => _colToggleOpen = !_colToggleOpen"
                            aria-expanded="@(_colToggleOpen ? "true" : "false")"
                            aria-haspopup="listbox">
                        <UiIcon Name="columns" Size="16" />
                        <span class="ui-hide-sm">@ColumnsLabel</span>
                    </button>
                    @if (_colToggleOpen)
                    {
                        <div class="ui-dropdown__panel ui-dropdown__panel--end" role="listbox" aria-label="@ColumnsLabel">
                            @foreach (var col in _columns)
                            {
                                var c = col;
                                <label class="ui-menu__item ui-grid__col-toggle-item">
                                    <input type="checkbox" checked="@c.Visible" @onchange="() => ToggleColumnVisibility(c)" />
                                    @c.Title
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @* Export button — shows scope explicitly to avoid ambiguity *@
            @if (CanExport)
            {
                <div class="ui-dropdown @(_exportOpen ? "is-open" : null)" data-testid="export-toolbar">
                    <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm @(_exportBusy ? "is-loading" : null)"
                            @onclick="() => _exportOpen = !_exportOpen"
                            aria-expanded="@(_exportOpen ? "true" : "false")"
                            aria-haspopup="menu"
                            disabled="@_exportBusy">
                        <UiIcon Name="download" Size="16" />
                        <span class="ui-hide-sm">@ExportLabel</span>
                    </button>
                    @if (_exportOpen)
                    {
                        <div class="ui-dropdown__panel ui-dropdown__panel--end" role="menu">
                            @if (AllowCsvExport)
                            {
                                <button type="button" class="ui-menu__item @(VirtualProvider != null ? "is-disabled" : null)" role="menuitem"
                                        disabled="@(VirtualProvider != null)"
                                        title="@(VirtualProvider != null ? VirtualCurrentPageUnavailableLabel : null)"
                                        @onclick="() => ExportCsvAsync(DataGridExportScope.CurrentPage)">
                                    <UiIcon Name="file-text" Size="16" /> @ExportCsvCurrentPageLabel
                                </button>
                                <button type="button" class="ui-menu__item" role="menuitem"
                                        @onclick="() => ExportCsvAsync(DataGridExportScope.AllFilteredRows)">
                                    <UiIcon Name="file-text" Size="16" /> @ExportCsvAllLabel
                                </button>
                            }
                            @if (AllowXlsxExport)
                            {
                                <button type="button" class="ui-menu__item @(VirtualProvider != null ? "is-disabled" : null)" role="menuitem"
                                        disabled="@(VirtualProvider != null)"
                                        title="@(VirtualProvider != null ? VirtualCurrentPageUnavailableLabel : null)"
                                        @onclick="() => ExportXlsxAsync(DataGridExportScope.CurrentPage)">
                                    <UiIcon Name="file-spreadsheet" Size="16" /> @ExportXlsxCurrentPageLabel
                                </button>
                                <button type="button" class="ui-menu__item" role="menuitem"
                                        @onclick="() => ExportXlsxAsync(DataGridExportScope.AllFilteredRows)">
                                    <UiIcon Name="file-spreadsheet" Size="16" /> @ExportXlsxAllLabel
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (Selectable && _selected.Count > 0)
            {
                <span class="ui-grid__selected">@string.Format(SelectedFormat, _selected.Count)</span>
            }
        </div>
    }

    @* ───────────────────────── Active column filters ───────────────────────── *@
    @if (_columnFilters.Count > 0)
    {
        <div class="ui-grid__filter-chips">
            @foreach (var (col, val) in _columnFilters)
            {
                var c = col;
                <span class="ui-grid__filter-chip">
                    <span class="ui-grid__filter-chip-label">@c.Title: @val</span>
                    <button type="button" class="ui-grid__filter-chip-clear" @onclick="() => ClearColumnFilter(c)"
                            aria-label="@ClearFilterLabel @c.Title">
                        <UiIcon Name="x" Size="12" />
                    </button>
                </span>
            }
            @if (_columnFilters.Count > 1)
            {
                <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="ClearAllFilters">@ClearAllFiltersLabel</button>
            }
        </div>
    }

    @* ───────────────────────── Error state ───────────────────────── *@
    @if (_error != null)
    {
        <div class="ui-grid__error" role="alert">
            <UiIcon Name="alert-circle" Size="20" />
            <span>@_error</span>
            <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="RetryAsync">@RetryLabel</button>
        </div>
    }

    @if (_exportError != null)
    {
        <div class="ui-grid__error" role="alert">
            <UiIcon Name="alert-circle" Size="20" />
            <span>@_exportError</span>
        </div>
    }

    @* ───────────────────────── Table ───────────────────────── *@
    <div class="@scrollClass" @ref="_scrollRef" data-testid="virtualize-wrapper">
        <table class="ui-grid__table">
            <thead>
                <tr>
                    @if (Selectable)
                    {
                        <th class="ui-grid__check" scope="col">
                            <UiCheckbox Checked="AllOnPageSelected" CheckedChanged="ToggleAllAsync" aria-label="@EffectiveSelectAllLabel" />
                        </th>
                    }
                    @foreach (var col in VisibleColumns)
                    {
                        var c = col;
                        <th scope="col" class="@HeaderClass(c)"
                            style="@ColStyle(c)"
                            aria-sort="@(c.Sortable ? SortAria(c) : null)">
                            <div class="ui-grid__th-inner">
                                @if (c.HeaderTemplate != null)
                                {
                                    @c.HeaderTemplate
                                }
                                else if (c.Sortable)
                                {
                                    <button type="button" class="ui-grid__sort" data-dir="@SortDir(c)"
                                            @onclick="() => SortAsync(c)">
                                        @c.Title
                                        <span class="ui-grid__sort-icons">
                                            @if (_activeSorts.Any(s => s.col == c))
                                            {
                                                var sortItem = _activeSorts.First(s => s.col == c);
                                                <UiIcon Name="@(sortItem.desc ? "arrow-down" : "arrow-up")" Size="13" />
                                                @if (_activeSorts.Count > 1)
                                                {
                                                    <span class="ui-grid__sort-rank">@(_activeSorts.IndexOf(sortItem) + 1)</span>
                                                }
                                            }
                                            else
                                            {
                                                <UiIcon Name="arrow-up-down" Size="13" />
                                            }
                                        </span>
                                    </button>
                                }
                                else
                                {
                                    @c.Title
                                }

                                @* Column filter *@
                                @if (c.Filterable)
                                {
                                    <div class="ui-grid__col-filter @(_openFilterCol == c ? "is-open" : null)">
                                        <button type="button"
                                                class="ui-grid__col-filter-btn @(_columnFilters.ContainsKey(c) ? "is-active" : null)"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleFilterPanel(c)"
                                                aria-label="@FilterLabel @c.Title"
                                                aria-expanded="@(_openFilterCol == c ? "true" : "false")">
                                            <UiIcon Name="@(_columnFilters.ContainsKey(c) ? "filter-filled" : "filter")" Size="13" />
                                        </button>
                                        @if (_openFilterCol == c)
                                        {
                                            var hasFilter = _columnFilters.TryGetValue(c, out var curFilter);
                                            var curOp = hasFilter ? curFilter!.Operator : GetDefaultOperator(c.FilterType);
                                            var curVal = hasFilter ? curFilter!.Value : "";
                                            var curVal2 = hasFilter ? curFilter!.Value2 : "";
                                            var operators = GetSupportedOperators(c.FilterType);
                                            <div class="ui-grid__col-filter-panel" @onclick:stopPropagation="true">
                                                <div class="ui-grid__filter-op-row" style="margin-bottom:0.35rem;">
                                                    <select class="ui-input ui-input--sm"
                                                            style="width:100%;"
                                                            aria-label="@FilterLabel @c.Title"
                                                            value="@curOp.ToString()"
                                                            @onchange="e => OnFilterOperatorChanged(c, e.Value?.ToString())">
                                                        @foreach (var op in operators)
                                                        {
                                                            <option value="@op.ToString()">@OperatorLabel(op)</option>
                                                        }
                                                    </select>
                                                </div>
                                                @if (c.FilterType == "bool")
                                                {
                                                    <div style="display:flex; gap:0.35rem; margin-top:0.35rem;">
                                                        <button type="button" class="ui-btn ui-btn--primary ui-btn--sm"
                                                                @onclick="() => ApplyBoolFilterAsync(c, curOp)">
                                                            @ApplyFilterLabel
                                                        </button>
                                                        @if (hasFilter)
                                                        {
                                                            <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="() => ClearColumnFilter(c)">@ClearFilterLabel</button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <UiTextField Small="true"
                                                                 Placeholder="@FilterPlaceholderText(curOp)"
                                                                 Value="@curVal"
                                                                 ValueChanged="v => ApplyColumnFilterAsync(c, v, curOp, curVal2)"
                                                                 Type="@(c.FilterType)" />
                                                    @if (curOp == GridFilterOperator.Between)
                                                    {
                                                        <div style="margin-top:0.35rem;">
                                                            <UiTextField Small="true"
                                                                         Placeholder="To…"
                                                                         Value="@curVal2"
                                                                         ValueChanged="v2 => ApplyColumnFilterAsync(c, curVal, curOp, v2)"
                                                                         Type="@(c.FilterType)" />
                                                        </div>
                                                    }
                                                    @if (hasFilter)
                                                    {
                                                        <div style="margin-top:0.35rem;">
                                                            <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="() => ClearColumnFilter(c)">@ClearFilterLabel</button>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </th>
                    }
                    @if (EditMode == UiDataGridEditMode.Inline)
                    {
                        <th scope="col" class="ui-grid__actions-col">@ActionsLabel</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (VirtualProvider != null)
                {
                    @* Server-side range virtualization - always render Virtualize component *@
                    @if (Loading && _virtualTotalCount == null)
                    {
                        @* Initial query loading - show skeleton *@
                        @for (var r = 0; r < Math.Min(PageSize, 6); r++)
                        {
                            <tr aria-hidden="true">
                                @if (Selectable) { <td class="ui-grid__check"><UiSkeleton Width="18px" Height="18px" /></td> }
                                @foreach (var c in VisibleColumns)
                                {
                                    <td class="@CellClass(c)"><UiSkeleton Width="@(r % 2 == 0 ? "80%" : "60%")" /></td>
                                }
                            </tr>
                        }
                    }
                    else if (_virtualTotalCount == 0 && _error == null)
                    {
                        @* Valid empty result from provider *@
                        <tr>
                            <td colspan="@(_columns.Count(c => c.Visible) + (Selectable ? 1 : 0) + (EditMode == UiDataGridEditMode.Inline ? 1 : 0))" class="ui-grid__empty">
                                @if (EmptyTemplate != null) { @EmptyTemplate }
                                else { <UiEmptyState Icon="search" Title="@EmptyTitle" Description="@EmptyDescription" /> }
                            </td>
                        </tr>
                    }
                    @* Keep the range provider mounted even when the current query is empty. *@
                    <Virtualize TItem="RenderRow" @ref="_virtualizeRef" ItemsProvider="@LoadVirtualItemsAsync" ItemSize="@VirtualRowHeight" OverscanCount="@VirtualOverscan" SpacerElement="tr">
                        @{
                            var row = context.Item;
                            var isEditing = _editingRow != null && RowKeyEquals(_editingRow, row);
                            var editRow = isEditing ? _editCopy! : row;
                            var isSelected = IsRowSelected(row);
                            var rowKey = context.DisplayKey;
                            var uniqueKey = context.RenderKey;
                        }
                        <tr @key="@uniqueKey" data-row data-row-key="@rowKey" class="@(isSelected ? "is-selected" : null) @(isEditing ? "is-editing" : null) @(_editSaveFailed && isEditing ? "is-edit-error" : null)"
                            tabindex="@(OnRowClick.HasDelegate ? 0 : null)"
                            @onclick="() => RowClickedAsync(row)"
                            @onkeydown="e => RowKeyAsync(e, row)">
                            @if (Selectable)
                            {
                                <td class="ui-grid__check" @onclick:stopPropagation="true">
                                    <UiCheckbox Checked="isSelected" CheckedChanged="v => ToggleRowAsync(row, v)" aria-label="@SelectRowLabel" />
                                </td>
                            }
                            @foreach (var col in VisibleColumns)
                            {
                                var c = col;
                                <td data-label="@c.Title" class="@CellClass(c)">
                                    @if (isEditing && c.EditTemplate != null)
                                    {
                                        @c.EditTemplate(editRow)
                                    }
                                    else if (c.Template != null)
                                    {
                                        @c.Template(row)
                                    }
                                    else
                                    {
                                        @c.Display(row)
                                    }
                                </td>
                            }
                            @if (EditMode == UiDataGridEditMode.Inline)
                            {
                                <td class="ui-grid__actions-col" @onclick:stopPropagation="true">
                                    @if (isEditing)
                                    {
                                        <button type="button" class="ui-btn ui-btn--sm" disabled="@_saveInProgress" @onclick="() => CommitEditAsync(editRow)">@SaveLabel</button>
                                        <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="CancelEdit">@CancelLabel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="ui-iconbtn" @onclick="() => BeginEdit(row)" aria-label="@EditLabel">
                                            <UiIcon Name="edit" Size="16" />
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    </Virtualize>
                }
                else if (Loading)
                {
                    @* Loading state for non-virtual modes *@
                    @for (var r = 0; r < Math.Min(PageSize, 6); r++)
                    {
                        <tr aria-hidden="true">
                            @if (Selectable) { <td class="ui-grid__check"><UiSkeleton Width="18px" Height="18px" /></td> }
                            @foreach (var c in VisibleColumns)
                            {
                                <td class="@CellClass(c)"><UiSkeleton Width="@(r % 2 == 0 ? "80%" : "60%")" /></td>
                            }
                        </tr>
                    }
                }
                else if (_pageItems.Count == 0 && _error == null)
                {
                    @* Empty state for non-virtual modes *@
                    <tr>
                        <td colspan="@(_columns.Count(c => c.Visible) + (Selectable ? 1 : 0) + (EditMode == UiDataGridEditMode.Inline ? 1 : 0))" class="ui-grid__empty">
                            @if (EmptyTemplate != null) { @EmptyTemplate }
                            else { <UiEmptyState Icon="search" Title="@EmptyTitle" Description="@EmptyDescription" /> }
                        </td>
                    </tr>
                }
                else if (VirtualizationMode == UiDataGridVirtualization.Enabled)
                {
                    @* Page-level rendering virtualization (Items already loaded) *@
                    <Virtualize TItem="RenderRow" Items="@pageRows" ItemSize="@VirtualRowHeight" OverscanCount="@VirtualOverscan" SpacerElement="tr">
                        @{
                            var row = context.Item;
                            var isEditing = _editingRow != null && RowKeyEquals(_editingRow, row);
                            var editRow = isEditing ? _editCopy! : row;
                            var isSelected = IsRowSelected(row);
                            var rowKey = context.DisplayKey;
                            var uniqueKey = context.RenderKey;
                        }
                        <tr @key="@uniqueKey" data-row data-row-key="@rowKey" class="@(isSelected ? "is-selected" : null) @(isEditing ? "is-editing" : null) @(_editSaveFailed && isEditing ? "is-edit-error" : null)"
                            tabindex="@(OnRowClick.HasDelegate ? 0 : null)"
                            @onclick="() => RowClickedAsync(row)"
                            @onkeydown="e => RowKeyAsync(e, row)">
                            @if (Selectable)
                            {
                                <td class="ui-grid__check" @onclick:stopPropagation="true">
                                    <UiCheckbox Checked="isSelected" CheckedChanged="v => ToggleRowAsync(row, v)" aria-label="@SelectRowLabel" />
                                </td>
                            }
                            @foreach (var col in VisibleColumns)
                            {
                                var c = col;
                                <td data-label="@c.Title" class="@CellClass(c)">
                                    @if (isEditing && c.EditTemplate != null)
                                    {
                                        @c.EditTemplate(editRow)
                                    }
                                    else if (c.Template != null)
                                    {
                                        @c.Template(row)
                                    }
                                    else
                                    {
                                        @c.Display(row)
                                    }
                                </td>
                            }
                            @if (EditMode == UiDataGridEditMode.Inline)
                            {
                                <td class="ui-grid__actions-col" @onclick:stopPropagation="true">
                                    @if (isEditing)
                                    {
                                        <button type="button" class="ui-btn ui-btn--sm" disabled="@_saveInProgress" @onclick="() => CommitEditAsync(editRow)">@SaveLabel</button>
                                        <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="CancelEdit">@CancelLabel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="ui-iconbtn" @onclick="() => BeginEdit(row)" aria-label="@EditLabel">
                                            <UiIcon Name="edit" Size="16" />
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    </Virtualize>
                }
                else
                {
                    @foreach (var entry in pageRows!)
                    {
                        var row = entry.Item;
                        var isEditing = _editingRow != null && RowKeyEquals(_editingRow, row);
                        // For editing, use the independent copy so the original is never mutated during editing.
                        var editRow = isEditing ? _editCopy! : row;
                        var rowKey = entry.DisplayKey;
                        var isSelected = IsRowSelected(row);
                        var uniqueKey = entry.RenderKey;
                        <tr @key="@uniqueKey" data-row data-row-key="@rowKey" class="@(isSelected ? "is-selected" : null) @(isEditing ? "is-editing" : null) @(_editSaveFailed && isEditing ? "is-edit-error" : null)"
                            tabindex="@(OnRowClick.HasDelegate ? 0 : null)"
                            @onclick="() => RowClickedAsync(row)"
                            @onkeydown="e => RowKeyAsync(e, row)">
                            @if (Selectable)
                            {
                                <td class="ui-grid__check" @onclick:stopPropagation="true">
                                    <UiCheckbox Checked="isSelected" CheckedChanged="v => ToggleRowAsync(row, v)" aria-label="@SelectRowLabel" />
                                </td>
                            }
                            @foreach (var col in VisibleColumns)
                            {
                                var c = col;
                                <td data-label="@c.Title" class="@CellClass(c)">
                                    @if (isEditing && c.EditTemplate != null)
                                    {
                                        @c.EditTemplate(editRow)
                                    }
                                    else if (c.Template != null)
                                    {
                                        @c.Template(row)
                                    }
                                    else
                                    {
                                        @c.Display(row)
                                    }
                                </td>
                            }
                            @if (EditMode == UiDataGridEditMode.Inline)
                            {
                                <td class="ui-grid__actions-col" @onclick:stopPropagation="true">
                                    @if (isEditing)
                                    {
                                        <button type="button" class="ui-btn ui-btn--sm" @onclick="() => CommitEditAsync(editRow)">@SaveLabel</button>
                                        <button type="button" class="ui-btn ui-btn--ghost ui-btn--sm" @onclick="CancelEdit">@CancelLabel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="ui-iconbtn" @onclick="() => BeginEdit(row)" aria-label="@EditLabel">
                                            <UiIcon Name="edit" Size="16" />
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ───────────────────────── Footer ───────────────────────── *@
    @if (VirtualProvider == null)
    {
        <div class="ui-grid__footer">
            <UiPagination Page="_page" PageSize="PageSize" TotalItems="_filteredCount" PageChanged="PageChangedAsync"
                          SummaryFormat="@SummaryFormat" PreviousLabel="@PreviousLabel" NextLabel="@NextLabel" PageLabel="@PageLabel" />
        </div>
    }
</div>

@code {
    // ─────────────────── private state ───────────────────
    private readonly List<UiColumn<TItem>> _columns = new();
    private readonly Dictionary<RowIdentity, TItem> _selected = new();
    private readonly List<(UiColumn<TItem> col, bool desc)> _activeSorts = new();
    private readonly Dictionary<UiColumn<TItem>, ColumnFilterState> _columnFilters = new();

    private List<TItem> _pageItems = new();
    private readonly Dictionary<RowIdentity, TItem> _loadedVirtualItems = new();
    private const int MaxLoadedVirtualItems = 10000; // Prevent unbounded memory growth
    private int _filteredCount;
    private int _page = 1;
    private string _search = "";
    private IEnumerable<TItem>? _lastItems;
    private bool _colToggleOpen;
    private bool _exportOpen;
    private UiColumn<TItem>? _openFilterCol;
    private string? _error;
    /// <summary>Reference to the original row being edited (used for identity comparison only).</summary>
    private TItem? _editingRow;
    /// <summary>Independent deep-clone of the row being edited. All EditTemplate bindings target this copy.</summary>
    private TItem? _editCopy;
    /// <summary>True when the last save attempt failed — keeps edit mode open with the copy intact.</summary>
    private bool _editSaveFailed;
    /// <summary>Prevents overlapping save operations.</summary>
    private bool _saveInProgress;
    private readonly object _ctsLock = new();
    private CancellationTokenSource _cts = new();
    private ElementReference _scrollRef;
    // Sequence number guards against stale async responses overwriting newer results.
    private int _requestSeq;
    // Export state
    private bool _exportBusy;
    private string? _exportError;
    // Set if component was disposed — prevents post-disposal state updates
    private bool _disposed;

    // Query caching (Finding B-04)
    private List<TItem>? _filteredSortedCache;
    private string? _lastCacheKey;

    // Virtual provider state (Finding B-08, B-09)
    private int? _virtualTotalCount; // Total count from last virtual query
    private int _virtualQueryGeneration; // Increments on each query change to prevent stale responses
    private Virtualize<RenderRow>? _virtualizeRef; // Reference to active Virtualize component
    private IDataGridVirtualDataProvider<TItem>? _lastVirtualProvider;
    private int _virtualRangeSequence;
    private CancellationTokenSource? _virtualQueryCts = new(); // Cancellation for current virtual query generation

    // Optional logger for diagnostic logging (nullable to avoid test failures)
    [Microsoft.AspNetCore.Components.Inject]
    private ILogger<UiDataGrid<TItem>>? Logger { get; set; }

    [Inject] private Microsoft.JSInterop.IJSRuntime? _js { get; set; }

    // ─────────────────── Parameters ───────────────────

    // Data sources (mutually exclusive)
    /// <summary>In-memory data source. The grid filters, sorts and pages it in memory.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    /// <summary>Server-side data provider. When set, Items is ignored.</summary>
    [Parameter] public IDataGridDataProvider<TItem>? ServerProvider { get; set; }
    /// <summary>
    /// Server-side virtual data provider for true range-based virtualization.
    /// When set, Items and ServerProvider are ignored, and VirtualizationMode is forced to Enabled.
    /// Only the visible range is fetched from the server (no pagination controls).
