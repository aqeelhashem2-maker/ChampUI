    // ─────────────────── inline editing (copy-on-edit) ───────────────────

    /// <summary>
    /// Begin editing a row. Creates an independent deep clone via JSON round-trip so that
    /// all edit-template bindings target the copy, never the original.
    /// <br/>
    /// Requirement: <typeparamref name="TItem"/> must be JSON-serialisable (records and POCOs with public
    /// properties always qualify). Reference cycles or non-serialisable types will throw at runtime.
    /// </summary>
    private void BeginEdit(TItem item)
    {
        _editingRow = item;
        _editCopy = CloneItem(item);
        _editSaveFailed = false;
    }

    /// <summary>Discard the edit copy. The original row is completely unchanged.</summary>
    private void CancelEdit()
    {
        _editingRow = default;
        _editCopy = default;
        _editSaveFailed = false;
    }

    /// <summary>
    /// Save the edited copy. If <see cref="OnRowSaved"/> throws, editing remains open with
    /// the copy intact so the user does not lose their changes.
    /// Exception is logged and preserved edit state allows retry.
    /// </summary>
    private async Task CommitEditAsync(TItem editedCopy)
    {
        // Guard against overlapping save operations (Finding B-06)
        if (_saveInProgress)
        {
            Logger?.LogWarning("Ignoring duplicate save attempt while save is in progress");
            return;
        }

        _saveInProgress = true;
        _editSaveFailed = false;
        try
        {
            if (OnRowSaved.HasDelegate)
                await OnRowSaved.InvokeAsync(editedCopy);
            // Only clear edit state after a successful save
            _editingRow = default;
            _editCopy = default;
            _error = null; // Clear any previous errors
        }
        catch (Exception ex)
        {
            // Log diagnostic details for debugging
            Logger?.LogError(ex, "Save failed for edited row in DataGrid");
            
            // Keep edit mode open — the copy still holds the user's changes
            _editSaveFailed = true;
            
            // Set user-facing error message
            _error = "Save failed. Please try again.";
            
            // Do NOT re-throw - prevent circuit termination in Blazor Server
        }
        finally
        {
            _saveInProgress = false;
        }
    }

    /// <summary>
    /// Deep-clones <paramref name="item"/> via JSON serialisation.
    /// Primitive types, records, and normal POCOs with public properties always work.
    /// </summary>
    private static TItem CloneItem(TItem item)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(item);
        return System.Text.Json.JsonSerializer.Deserialize<TItem>(json)
               ?? throw new InvalidOperationException("Failed to clone row item for editing.");
    }

    // ─────────────────── Row identity & selection helpers (Finding B-05) ───────────────────

    // ─────────────────── Row Identity Management (Audit Finding 3) ───────────────────

    private readonly record struct RowIdentity(Type? KeyType, object? Key, TItem? FallbackItem);
    private sealed record RenderRow(TItem Item, object? DisplayKey, object RenderKey);

    private RowIdentity GetRowIdentity(TItem row)
    {
        var key = row is null ? null : RowKeySelector?.Invoke(row);
        return key is null ? new(null, null, row) : new(key.GetType(), key, default);
    }

    private List<RenderRow> GetRenderRows(IEnumerable<TItem> items)
    {
        var rows = items.Select(item => (Item: item, Identity: GetRowIdentity(item))).ToList();
        var seen = new HashSet<RowIdentity>();
        var duplicates = new HashSet<RowIdentity>();
        foreach (var row in rows)
            if (!seen.Add(row.Identity)) duplicates.Add(row.Identity);

        // Duplicate identities cannot preserve per-row render state. Give each occurrence a
        // distinct render-only key so Blazor cannot transfer state between duplicate rows.
        return rows.Select(row => new RenderRow(row.Item, row.Identity.Key ?? (object?)row.Item,
            duplicates.Contains(row.Identity) ? new object() : row.Identity)).ToList();
    }

    private bool RowKeyEquals(TItem a, TItem b) => GetRowIdentity(a).Equals(GetRowIdentity(b));

    private bool IsRowSelected(TItem row) => _selected.ContainsKey(GetRowIdentity(row));

    private void SetRowSelected(TItem item, bool selected)
    {
        var identity = GetRowIdentity(item);
        if (selected)
            _selected.TryAdd(identity, item);
        else
            _selected.Remove(identity);
    }

    private async Task ToggleRowAsync(TItem item, bool selected)
    {
        SetRowSelected(item, selected);
        await SelectedItemsChanged.InvokeAsync(_selected.Values.ToList());
    }

    /// <summary>
    /// Toggles selection for all items in the current selection scope.
    /// 
    /// Selection scope:
    /// - VirtualProvider: All loaded items (up to MaxLoadedVirtualItems = 10,000).
    ///   Items loaded after this limit are NOT automatically selected.
    /// - Paged grids: All items on the current page.
    /// - In-memory grids: All items on the current page.
    /// 
    /// Note: This does NOT select all server records. For full dataset selection,
    /// implement custom logic using GetAllForExportAsync or similar server API.
    /// </summary>
    private async Task ToggleAllAsync(bool selected)
    {
        IEnumerable<TItem> scope = VirtualProvider != null ? _loadedVirtualItems.Values : _pageItems;
        foreach (var item in scope)
            SetRowSelected(item, selected);

        await SelectedItemsChanged.InvokeAsync(_selected.Values.ToList());
    }

    // ─────────────────── Virtual data provider support (Finding B-01, B-09, B-10, B-11) ───────────────────

    /// <summary>
    /// ItemsProvider for Blazor Virtualize component.
    /// Handles range requests, cancellation, query generations, and loading states.
    /// </summary>
    private async ValueTask<ItemsProviderResult<RenderRow>> LoadVirtualItemsAsync(ItemsProviderRequest request)
    {
        var empty = new ItemsProviderResult<RenderRow>(Array.Empty<RenderRow>(), 0);
        var provider = VirtualProvider;
        if (provider == null || _disposed || request.CancellationToken.IsCancellationRequested)
            return empty;

        var generation = _virtualQueryGeneration;
        var sequence = ++_virtualRangeSequence;
        using var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(
            request.CancellationToken, _virtualQueryCts?.Token ?? CancellationToken.None);
        var token = linkedCts.Token;
        bool IsCurrent() => !token.IsCancellationRequested && !_disposed &&
            generation == _virtualQueryGeneration && sequence == _virtualRangeSequence &&
            ReferenceEquals(provider, VirtualProvider);

        try
        {
            var result = await provider.GetVirtualDataAsync(BuildVirtualRequest(request.StartIndex, request.Count, token));
            if (!IsCurrent()) return empty;

            if (result == null || result.TotalCount < 0)
            {
                Logger?.LogWarning("VirtualProvider returned an invalid response");
                return empty;
            }

            var rows = GetRenderRows(result.Items);
            var renderGrid = _virtualTotalCount != result.TotalCount || Loading || _error != null;
            _virtualTotalCount = result.TotalCount;
            _error = null;
            Loading = false;

            var allSelectedBefore = Selectable && AllOnPageSelected;
            foreach (var item in result.Items)
            {
                if (_loadedVirtualItems.Count >= MaxLoadedVirtualItems)
                    break;
                _loadedVirtualItems.TryAdd(GetRowIdentity(item), item);
            }

            if (renderGrid || (Selectable && allSelectedBefore != AllOnPageSelected)) StateHasChanged();
            return new ItemsProviderResult<RenderRow>(rows, result.TotalCount);
        }
        catch (OperationCanceledException) when (!IsCurrent())
        {
            return empty;
        }
        catch (Exception ex)
        {
            if (IsCurrent())
            {
                Logger?.LogError(ex, "Virtual data provider failed for DataGrid");
                _error = ErrorMessage;
                _virtualTotalCount = 0;
                Loading = false;
                StateHasChanged();
            }
            return empty;
        }
    }

    private DataGridVirtualRequest BuildVirtualRequest(int startIndex, int count, CancellationToken ct) => new()
    {
        StartIndex = startIndex,
        // Don't silently truncate - let Virtualize handle its own viewport (Finding B-11)
        // Provider can implement its own batching strategy if needed
        Count = count,
        GlobalSearch = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
        Sorts = _activeSorts.Select(s => new GridSortDescriptor(s.col.Field ?? s.col.Title, s.desc)).ToList(),
        Filters = _columnFilters.Select(kvp =>
            new GridFilterDescriptor(
                kvp.Key.Field ?? kvp.Key.Title,
                kvp.Value.Operator,
                kvp.Value.Value,
                kvp.Value.Value2)
        ).ToList(),
        CancellationToken = ct,
    };

    // ─────────────────── export ───────────────────

    private Task ExportCsvAsync(DataGridExportScope scope) => ExportAsync(scope, xlsx: false);

    private Task ExportXlsxAsync(DataGridExportScope scope) => ExportAsync(scope, xlsx: true);

    private async Task ExportAsync(DataGridExportScope scope, bool xlsx)
    {
        if (_exportBusy || _disposed) return;

        _exportOpen = false;
        _exportBusy = true;
        _exportError = null;
        var generation = _virtualQueryGeneration;
        var provider = VirtualProvider;
        bool IsCurrent() => !_disposed && generation == _virtualQueryGeneration &&
            ReferenceEquals(provider, VirtualProvider);
        StateHasChanged();
        try
        {
            var rows = await GetExportRowsAsync(scope);
            if (!IsCurrent()) return;

            if (xlsx)
            {
                await DownloadFileAsync("export.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", BuildXlsx(rows));
                return;
            }

            var csv = BuildCsv(rows);
            
            // Add UTF-8 BOM explicitly for Excel compatibility
            var utf8 = System.Text.Encoding.UTF8;
            var csvBytes = utf8.GetBytes(csv);
            var bomBytes = new byte[] { 0xEF, 0xBB, 0xBF }; // UTF-8 BOM
            var output = new byte[bomBytes.Length + csvBytes.Length];
            System.Buffer.BlockCopy(bomBytes, 0, output, 0, bomBytes.Length);
            System.Buffer.BlockCopy(csvBytes, 0, output, bomBytes.Length, csvBytes.Length);
            
            await DownloadFileAsync("export.csv", "text/csv", output);
        }
        catch (FullExportUnavailableException)
        {
            if (IsCurrent()) _exportError = ExportAllUnavailableLabel;
        }
        catch (Exception ex)
        {
            if (IsCurrent())
            {
                Logger?.LogError(ex, "Export failed for DataGrid");
                _exportError = ExportErrorMessage;
            }
        }
        finally
        {
            _exportBusy = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task<IEnumerable<TItem>> GetExportRowsAsync(DataGridExportScope scope)
    {
        if (scope == DataGridExportScope.CurrentPage)
        {
            if (VirtualProvider != null)
                throw new InvalidOperationException(VirtualCurrentPageUnavailableLabel);

            return _pageItems.ToList();
        }

        if (VirtualProvider is { } virtualProvider)
        {
            using var cts = CancellationTokenSource.CreateLinkedTokenSource(
                _virtualQueryCts?.Token ?? CancellationToken.None);
            cts.CancelAfter(TimeSpan.FromSeconds(120));
            var request = BuildVirtualRequest(0, 0, cts.Token);
            var result = await virtualProvider.GetAllForExportAsync(request).WaitAsync(cts.Token);
            cts.Token.ThrowIfCancellationRequested();
            return result?.Items ?? throw new FullExportUnavailableException();
        }

        if (ServerProvider is { } serverProvider)
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(120));
            var request = BuildRequest(cts.Token);

            if (ServerExportAll != null)
                return await ServerExportAll(request);

            var result = await serverProvider.GetAllForExportAsync(request);
            return result?.Items ?? throw new FullExportUnavailableException();
        }

        return QueryInMemory().ToList();
    }

    private sealed class FullExportUnavailableException() : InvalidOperationException(
        "Full-dataset export is unavailable. Provide ServerExportAll or implement GetAllForExportAsync.");

    private string BuildCsv(IEnumerable<TItem> rows)
    {
        var cols = VisibleColumns.ToList();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", cols.Select(c => CsvQuote(c.Title))));
        foreach (var row in rows)
            sb.AppendLine(string.Join(",", cols.Select(c => CsvQuote(c.Display(row)))));
        return sb.ToString();
    }

    private static string CsvQuote(string value)
    {
        // Neutralise formula injection (CSV injection / DDE injection)
        // Check for leading formula triggers: =, +, -, @, \t, \r
        // Also check if leading whitespace precedes any formula trigger: e.g. "   =cmd"
        var trimmed = value.TrimStart();
        var safe = value;
        if (trimmed.Length > 0 && (trimmed[0] == '=' || trimmed[0] == '+' || trimmed[0] == '-' || trimmed[0] == '@' || trimmed[0] == '\t' || trimmed[0] == '\r'))
            safe = "'" + value;
        var escaped = safe.Replace("\"", "\"\"");
        return $"\"{escaped}\"";
    }

    /// <summary>
    /// Builds an XLSX workbook with type-aware cell serialisation.
    /// Supported cell types: string (inlineStr), integer/decimal (n), boolean (b), date/DateTime/DateOnly (numeric serial with s="1").
    /// Formula injection is neutralised for string cells.
    /// </summary>
    private byte[] BuildXlsx(IEnumerable<TItem> rows)
    {
        var cols = VisibleColumns.ToList();
        var dataRows = rows.ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append("<sheetData>");

        // Header row — always strings
        sb.Append("<row r=\"1\">");
        for (var ci = 0; ci < cols.Count; ci++)
        {
            var cellRef = ColLetter(ci + 1) + "1";
            sb.Append($"<c r=\"{cellRef}\" t=\"inlineStr\"><is><t>{XmlEscape(cols[ci].Title)}</t></is></c>");
        }
        sb.Append("</row>");

        // Data rows — type-aware
        for (var ri = 0; ri < dataRows.Count; ri++)
        {
            sb.Append($"<row r=\"{ri + 2}\">");
            for (var ci = 0; ci < cols.Count; ci++)
            {
                var cellRef = ColLetter(ci + 1) + (ri + 2);
                var raw = cols[ci].Raw(dataRows[ri]);
                sb.Append(BuildXlsxCell(cellRef, raw));
            }
            sb.Append("</row>");
        }
        sb.Append("</sheetData>");

        return WriteXlsxPackage(sb.ToString());
    }

    /// <summary>Serialises a single cell value with correct OOXML type attributes.</summary>
    private static string BuildXlsxCell(string cellRef, object? raw)
    {
        if (raw is null) return $"<c r=\"{cellRef}\"/>";

        return raw switch
        {
            bool b => $"<c r=\"{cellRef}\" t=\"b\"><v>{(b ? 1 : 0)}</v></c>",

            byte or sbyte or short or ushort or int or uint or long or ulong
                => $"<c r=\"{cellRef}\"><v>{raw}</v></c>",

            float f   => $"<c r=\"{cellRef}\"><v>{f.ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",
            double d  => $"<c r=\"{cellRef}\"><v>{d.ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",
            decimal m => $"<c r=\"{cellRef}\"><v>{m.ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",

            DateTime dt =>
                $"<c r=\"{cellRef}\" s=\"2\"><v>{DateTimeToOADate(dt).ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",
            DateOnly donly =>
                $"<c r=\"{cellRef}\" s=\"1\"><v>{DateToOADate(donly.ToDateTime(TimeOnly.MinValue)).ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",
            DateTimeOffset dto =>
                $"<c r=\"{cellRef}\" s=\"2\"><v>{DateTimeToOADate(dto.UtcDateTime).ToString(System.Globalization.CultureInfo.InvariantCulture)}</v></c>",

            _ => BuildXlsxStringCell(cellRef, raw.ToString() ?? ""),
        };
    }

    private static double DateToOADate(DateTime date)
    {
        var epoch = new DateTime(1899, 12, 30, 0, 0, 0, DateTimeKind.Unspecified);
        return (date.Date - epoch).TotalDays;
    }

    /// <summary>
    /// Converts DateTime to Excel OADate serial with time component.
    /// Date-only cells use style 1 (date format: mm-dd-yy).
    /// DateTime cells use style 2 (datetime format: mm-dd-yy h:mm).
    /// </summary>
    private static double DateTimeToOADate(DateTime dateTime)
    {
        var epoch = new DateTime(1899, 12, 30, 0, 0, 0, DateTimeKind.Unspecified);
        return (dateTime - epoch).TotalDays;
    }

    private static string BuildXlsxStringCell(string cellRef, string value)
    {
        var trimmed = value.TrimStart();
        var safe = value;
        if (trimmed.Length > 0 && (trimmed[0] == '=' || trimmed[0] == '+' || trimmed[0] == '-' || trimmed[0] == '@' || trimmed[0] == '\t' || trimmed[0] == '\r'))
            safe = "'" + value;
        return $"<c r=\"{cellRef}\" t=\"inlineStr\"><is><t>{XmlEscape(safe)}</t></is></c>";
    }

    private static byte[] WriteXlsxPackage(string sheetDataXml)
    {
        const string sheetXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">" +
            "{0}</worksheet>";

        const string workbookXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">" +
            "<sheets><sheet name=\"Sheet1\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>";

        const string stylesXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">" +
            "<numFmts count=\"0\"/>" +
            "<fonts count=\"1\"><font/></fonts>" +
            "<fills count=\"2\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill></fills>" +
            "<borders count=\"1\"><border/></borders>" +
            "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>" +
            "<cellXfs count=\"3\">" +
            "<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>" +
            "<xf numFmtId=\"14\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/>" +
            "<xf numFmtId=\"22\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/>" +
            "</cellXfs>" +
            "</styleSheet>";

        const string workbookRelsXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
            "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/>" +
            "<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>" +
            "</Relationships>";

        const string contentTypesXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">" +
            "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>" +
            "<Default Extension=\"xml\" ContentType=\"application/xml\"/>" +
            "<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>" +
            "<Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>" +
            "<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>" +
            "</Types>";

        using var ms = new System.IO.MemoryStream();
        using var zip = new System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Create, true);

        static void AddEntry(System.IO.Compression.ZipArchive z, string name, string xml)
        {
            var entry = z.CreateEntry(name);
            using var sw = new System.IO.StreamWriter(entry.Open(), System.Text.Encoding.UTF8);
            sw.Write(xml);
        }

        const string rootRels =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
            "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>" +
            "</Relationships>";

        AddEntry(zip, "[Content_Types].xml", contentTypesXml);
        AddEntry(zip, "_rels/.rels", rootRels);
        AddEntry(zip, "xl/workbook.xml", workbookXml);
        AddEntry(zip, "xl/_rels/workbook.xml.rels", workbookRelsXml);
        AddEntry(zip, "xl/styles.xml", stylesXml);
        AddEntry(zip, "xl/worksheets/sheet1.xml", string.Format(sheetXml, sheetDataXml));

        zip.Dispose();
        return ms.ToArray();
    }

    private static string ColLetter(int col)
    {
        var result = "";
        while (col > 0) { col--; result = (char)('A' + col % 26) + result; col /= 26; }
        return result;
    }

    private static string XmlEscape(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

    private async Task DownloadFileAsync(string filename, string mime, byte[] data)
    {
        if (_js == null) return;
        var base64 = Convert.ToBase64String(data);
        await _js.InvokeVoidAsync("ChampUI.downloadFile", filename, mime, base64);
    }

    // ─────────────────── CSS helpers ───────────────────
    private static string AlignClass(UiColumn<TItem> c) => c.Align switch { UiAlign.Center => "is-center", UiAlign.End => "is-end", _ => "" };
    private static string HeaderClass(UiColumn<TItem> c) => $"{AlignClass(c)} {(c.HideOnMobile ? "ui-hide-mobile" : "")}".Trim();
    private static string CellClass(UiColumn<TItem> c) => HeaderClass(c);
    private static string? ColStyle(UiColumn<TItem> c)
    {
        var parts = new List<string>();
        if (c.Width != null) parts.Add($"width:{c.Width}");
        if (c.MinWidth != null) parts.Add($"min-width:{c.MinWidth}");
        return parts.Count > 0 ? string.Join(";", parts) : null;
    }

    // ─────────────────── value comparison (for in-memory sort) ───────────────────
    private static int CompareValues(object? a, object? b)
    {
        if (a is null && b is null) return 0;
        if (a is null) return -1;
        if (b is null) return 1;
        if (a is string sa && b is string sb) return string.Compare(sa, sb, StringComparison.CurrentCultureIgnoreCase);
        if (a is IComparable ca && a.GetType() == b.GetType()) return ca.CompareTo(b);
        return string.Compare(a.ToString(), b.ToString(), StringComparison.CurrentCultureIgnoreCase);
    }

    // ─────────────────── B-03: Virtualization Configuration Validation ───────────────────
    
    private void ValidateVirtualizationParameters()
    {
        // Validate VirtualRowHeight
        if (float.IsNaN(VirtualRowHeight) || float.IsInfinity(VirtualRowHeight) || VirtualRowHeight <= 0)
        {
            throw new InvalidOperationException(
                $"VirtualRowHeight must be a positive finite number. Current value: {VirtualRowHeight}. " +
                "Valid range: > 0 (typically 32-80px).");
        }

        // Validate VirtualOverscan
        if (VirtualOverscan < 0)
        {
            throw new InvalidOperationException(
                $"VirtualOverscan must be >= 0. Current value: {VirtualOverscan}. " +
                "Valid range: 0-20 (higher values improve scroll smoothness but increase DOM size).");
        }

        // Validate VirtualViewportHeight syntax if provided
        if (!string.IsNullOrWhiteSpace(VirtualViewportHeight))
        {
            var height = VirtualViewportHeight.Trim();
            var isValid = height.EndsWith("px", StringComparison.OrdinalIgnoreCase) ||
                          height.EndsWith("vh", StringComparison.OrdinalIgnoreCase) ||
                          height.EndsWith("rem", StringComparison.OrdinalIgnoreCase) ||
                          height.EndsWith("em", StringComparison.OrdinalIgnoreCase) ||
                          height.EndsWith("%", StringComparison.Ordinal);
            
            if (!isValid)
            {
                throw new InvalidOperationException(
                    $"VirtualViewportHeight must be a valid CSS height value (e.g., '400px', '50vh', '20rem'). " +
                    $"Current value: '{VirtualViewportHeight}'.");
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        
        // Cancel and dispose legacy CTS
        lock (_ctsLock)
        {
            try { _cts.Cancel(); } catch (ObjectDisposedException) { }
            _cts.Dispose();
        }
        
        // Cancel and dispose virtual query CTS
        if (_virtualQueryCts != null)
        {
            try { _virtualQueryCts.Cancel(); } catch (ObjectDisposedException) { }
            _virtualQueryCts.Dispose();
            _virtualQueryCts = null;
        }
    }
}
