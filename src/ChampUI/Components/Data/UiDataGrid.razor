    {
        get
        {
            // For virtual provider, check loaded virtual items
            if (VirtualProvider != null)
                return _loadedVirtualItems.Count > 0 && _loadedVirtualItems.Keys.All(_selected.ContainsKey);
            
            // For other modes, use page items
            return _pageItems.Count > 0 && _pageItems.All(IsRowSelected);
