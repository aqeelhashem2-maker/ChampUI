    private IEnumerable<UiColumn<TItem>> VisibleColumns => _columns.Where(c => c.Visible);

    // ─────────────────── lifecycle ───────────────────

    private void SafeInvokeAsync(Func<Task> work)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            try 
            { 
                await work(); 
            }
            catch (OperationCanceledException) 
            { 
                // Expected during cancellation — safe to ignore
            }
            catch (Exception ex)
            {
                // Log diagnostic details for debugging (if logger available)
                Logger?.LogError(ex, "Background task failed in DataGrid component");
                
                // Display safe generic message to users (never expose exception details)
                if (!_disposed)
                {
                    _error = ErrorMessage; // Generic message only
                    Loading = false;
                }
            }
            if (!_disposed) StateHasChanged();
        });
    }

    internal void RegisterColumn(UiColumn<TItem> column)
    {
        _columns.Add(column);
        SafeInvokeAsync(RecomputeAsync);
    }

    internal void UnregisterColumn(UiColumn<TItem> column)
    {
        _columns.Remove(column);
        _activeSorts.RemoveAll(s => s.col == column);
        _columnFilters.Remove(column);
        SafeInvokeAsync(RecomputeAsync);
    }

    internal void ColumnChanged() => SafeInvokeAsync(RecomputeAsync);

    /// <summary>Forces the grid to reload data from page 1 and invalidates cache.</summary>
    public void Refresh() 
    { 
        _page = 1; 
        _filteredSortedCache = null; // Invalidate cache
        _lastCacheKey = null;
        SafeInvokeAsync(RecomputeAsync); 
    }
    public Task RefreshAsync() 
    { 
        _page = 1; 
        _filteredSortedCache = null; // Invalidate cache
        _lastCacheKey = null;
        return RecomputeAsync(); 
    }

    /// <summary>Called by UiColumn when its Visible property changes.</summary>
    public void RequestRefresh() => SafeInvokeAsync(RecomputeAsync);

    protected override void OnParametersSet()
    {
        // B-03: Validate virtualization configuration
        ValidateVirtualizationParameters();
        
        if (SelectedItems != null)
        {
            _selected.Clear();
            foreach (var item in SelectedItems)
                _selected.TryAdd(GetRowIdentity(item), item);
        }
        if (!ReferenceEquals(_lastItems, Items))
        {
            _lastItems = Items;
            _filteredSortedCache = null;
            _page = 1;
        }
        if (ServerProvider == null && VirtualProvider == null) RecomputeInMemory();
    }

    protected override async Task OnParametersSetAsync()
    {
        var previousVirtualProvider = _lastVirtualProvider;
        _lastVirtualProvider = VirtualProvider;
        if (previousVirtualProvider != null && !ReferenceEquals(previousVirtualProvider, VirtualProvider))
        {
            if (VirtualProvider != null)
                await RefreshVirtualQueryAsync();
            else
            {
                InvalidateVirtualQuery();
                _virtualizeRef = null;
                _virtualTotalCount = null;
            }
        }
        if (ServerProvider != null && VirtualProvider == null) await RecomputeServerAsync();
    }

    // ─────────────────── in-memory recompute ───────────────────
    // ─────────────────── in-memory recompute with caching (Finding B-04) ───────────────────
    
    private void RecomputeInMemory()
    {
        // Generate cache key based on query state
        var cacheKey = GenerateCacheKey();
        
        // Use cached result if query state hasn't changed
        List<TItem> filteredSorted;
        if (_lastCacheKey == cacheKey && _filteredSortedCache != null)
        {
            filteredSorted = _filteredSortedCache;
        }
        else
        {
            filteredSorted = QueryInMemory().ToList();

            // Cache the result
            _filteredSortedCache = filteredSorted;
            _lastCacheKey = cacheKey;
        }

        // Now extract the current page from cached results (only this part runs on scroll/page change)
        _filteredCount = filteredSorted.Count;
        var pages = PageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling(filteredSorted.Count / (double)PageSize));
        _page = Math.Clamp(_page, 1, pages);
        _pageItems = filteredSorted.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private IEnumerable<TItem> QueryInMemory()
    {
        IEnumerable<TItem> query = Items ?? Array.Empty<TItem>();

        if (Searchable && !string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            var searchable = _columns.Where(c => c.Searchable && c.Value != null).ToList();
            query = query.Where(item => searchable.Any(c => c.Display(item).Contains(term, StringComparison.CurrentCultureIgnoreCase)));
        }

        foreach (var (col, filter) in _columnFilters)
        {
            var c = col;
            var f = filter;
            if (string.IsNullOrWhiteSpace(f.Value) && f.Operator != GridFilterOperator.IsNull && f.Operator != GridFilterOperator.IsNotNull && f.Operator != GridFilterOperator.IsTrue && f.Operator != GridFilterOperator.IsFalse)
                continue;

            query = FilterQuery(query, c, f);
        }

        // Multi-sort
        IOrderedEnumerable<TItem>? ordered = null;
        for (var i = 0; i < _activeSorts.Count; i++)
        {
            var (col, desc) = _activeSorts[i];
            var c = col;
            var comparer = Comparer<object?>.Create(CompareValues);
            if (i == 0)
                ordered = desc ? query.OrderByDescending(item => c.Raw(item), comparer) : query.OrderBy(item => c.Raw(item), comparer);
            else
                ordered = desc ? ordered!.ThenByDescending(item => c.Raw(item), comparer) : ordered!.ThenBy(item => c.Raw(item), comparer);
        }
        if (ordered != null) query = ordered;
        return query;
    }

    private string GenerateCacheKey()
    {
        // Items reference changes invalidate the cache in OnParametersSet.
        // Changing page does NOT invalidate the cache
        var sb = new System.Text.StringBuilder();
        sb.Append(_search);
        sb.Append('|');
        foreach (var (col, filter) in _columnFilters)
        {
            sb.Append(col.Field ?? col.Title);
            sb.Append(':');
            sb.Append(filter.Operator);
            sb.Append(':');
            sb.Append(filter.Value);
            sb.Append(':');
            sb.Append(filter.Value2);
            sb.Append('|');
        }
        foreach (var (col, desc) in _activeSorts)
        {
            sb.Append(col.Field ?? col.Title);
            sb.Append(':');
            sb.Append(desc ? 'D' : 'A');
            sb.Append('|');
        }
        return sb.ToString();
    }

    private static IEnumerable<TItem> FilterQuery(IEnumerable<TItem> source, UiColumn<TItem> col, ColumnFilterState f)
    {
        return source.Where(item =>
        {
            var raw = col.Raw(item);
            var display = col.Display(item);

            switch (f.Operator)
            {
                case GridFilterOperator.Contains:
                    return display.Contains(f.Value, StringComparison.CurrentCultureIgnoreCase);
                case GridFilterOperator.NotContains:
                    return !display.Contains(f.Value, StringComparison.CurrentCultureIgnoreCase);
                case GridFilterOperator.StartsWith:
                    return display.StartsWith(f.Value, StringComparison.CurrentCultureIgnoreCase);
                case GridFilterOperator.EndsWith:
                    return display.EndsWith(f.Value, StringComparison.CurrentCultureIgnoreCase);
                case GridFilterOperator.Equals:
                    if (col.FilterType == "number" && double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var targetNum))
                    {
                        return raw != null && Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture).Equals(targetNum);
                    }
                    if (col.FilterType == "date" && DateTime.TryParse(f.Value, out var targetDt))
                    {
                        return raw is DateTime dt ? dt.Date == targetDt.Date :
                               raw is DateOnly donly ? donly == DateOnly.FromDateTime(targetDt) :
                               raw is DateTimeOffset dto && dto.Date == targetDt.Date;
                    }
                    return string.Equals(display, f.Value, StringComparison.CurrentCultureIgnoreCase);
                case GridFilterOperator.NotEquals:
                    if (col.FilterType == "number" && double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var targetNumNe))
                    {
                        return raw == null || !Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture).Equals(targetNumNe);
                    }
                    return !string.Equals(display, f.Value, StringComparison.CurrentCultureIgnoreCase);

                case GridFilterOperator.GreaterThan:
                case GridFilterOperator.After:
                    if (col.FilterType == "date" && DateTime.TryParse(f.Value, out var afterDt))
                    {
                        var itemDate = raw is DateTime dt ? dt.Date : raw is DateOnly donly ? donly.ToDateTime(TimeOnly.MinValue) : raw is DateTimeOffset dto ? dto.Date : (DateTime?)null;
                        return itemDate.HasValue && itemDate.Value > afterDt.Date;
                    }
                    if (double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var gtNum))
                    {
                        return raw != null && Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture) > gtNum;
                    }
                    return false;

                case GridFilterOperator.GreaterThanOrEqual:
                    if (double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var gteNum))
                    {
                        return raw != null && Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture) >= gteNum;
                    }
                    return false;

                case GridFilterOperator.LessThan:
                case GridFilterOperator.Before:
                    if (col.FilterType == "date" && DateTime.TryParse(f.Value, out var beforeDt))
                    {
                        var itemDate = raw is DateTime dt ? dt.Date : raw is DateOnly donly ? donly.ToDateTime(TimeOnly.MinValue) : raw is DateTimeOffset dto ? dto.Date : (DateTime?)null;
                        return itemDate.HasValue && itemDate.Value < beforeDt.Date;
                    }
                    if (double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var ltNum))
                    {
                        return raw != null && Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture) < ltNum;
                    }
                    return false;

                case GridFilterOperator.LessThanOrEqual:
                    if (double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lteNum))
                    {
                        return raw != null && Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture) <= lteNum;
                    }
                    return false;

                case GridFilterOperator.Between:
                    if (col.FilterType == "date" && DateTime.TryParse(f.Value, out var dt1) && DateTime.TryParse(f.Value2, out var dt2))
                    {
                        var itemDate = raw is DateTime dt ? dt.Date : raw is DateOnly donly ? donly.ToDateTime(TimeOnly.MinValue) : raw is DateTimeOffset dto ? dto.Date : (DateTime?)null;
                        return itemDate.HasValue && itemDate.Value >= dt1.Date && itemDate.Value <= dt2.Date;
                    }
                    if (double.TryParse(f.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n1) &&
                        double.TryParse(f.Value2, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n2))
                    {
                        if (raw == null) return false;
                        var val = Convert.ToDouble(raw, System.Globalization.CultureInfo.InvariantCulture);
                        return val >= Math.Min(n1, n2) && val <= Math.Max(n1, n2);
                    }
                    return false;

                case GridFilterOperator.IsNull:
                    return raw == null || string.IsNullOrEmpty(display);
                case GridFilterOperator.IsNotNull:
                    return raw != null && !string.IsNullOrEmpty(display);

                case GridFilterOperator.IsTrue:
                case GridFilterOperator.True:
                    return raw is bool bTrue ? bTrue : bool.TryParse(display, out var parsedTrue) && parsedTrue;
                case GridFilterOperator.IsFalse:
                case GridFilterOperator.False:
                    return raw is bool bFalse ? !bFalse : bool.TryParse(display, out var parsedFalse) && !parsedFalse;

                default:
                    return true;
            }
        });
    }

    private async Task RecomputeServerAsync()
    {
        if (ServerProvider == null || _disposed) return;

        // Assign request sequence BEFORE any asynchronous operations
        var seq = Interlocked.Increment(ref _requestSeq);

        // Safely replace CancellationTokenSource under lock
        CancellationTokenSource oldCts;
        CancellationTokenSource newCts;
        CancellationToken token;
        
        lock (_ctsLock)
        {
            if (_disposed) return;
            oldCts = _cts;
            _cts = newCts = new CancellationTokenSource();
            token = newCts.Token; // Capture token while still under lock
        }

        // Cancel and dispose old CTS outside the lock to avoid blocking
        try { await oldCts.CancelAsync(); }
        catch (ObjectDisposedException) { }
        finally { oldCts.Dispose(); }

        // Check if request is still relevant before proceeding
        if (seq != _requestSeq || _disposed || token.IsCancellationRequested) return;

        Loading = true;
        _error = null;
        StateHasChanged();
        
        try
        {
            var req = BuildRequest(token);
            var result = await ServerProvider.GetDataAsync(req);

            // Only update state if this is still the current request
            if (!token.IsCancellationRequested && seq == _requestSeq && !_disposed)
            {
                _pageItems = result.Items.ToList();
                _filteredCount = result.TotalCount;
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during cancellation — do not log as error
        }
        catch (Exception ex)
        {
            // Only set error if this is still the current request
            if (seq == _requestSeq && !_disposed)
            {
                Logger?.LogError(ex, "Server data provider failed for DataGrid");
                _error = ErrorMessage;
            }
        }
        finally
        {
            // Only update loading state if this is still the current request
            if (!token.IsCancellationRequested && seq == _requestSeq && !_disposed)
            {
                Loading = false;
                StateHasChanged();
            }
        }
    }

    private DataGridRequest BuildRequest(CancellationToken ct) => new()
    {
        Page = _page,
        PageSize = PageSize,
        GlobalSearch = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
        Sorts = _activeSorts.Select(s => new GridSortDescriptor(s.col.Field ?? s.col.Title, s.desc)).ToList(),
        Filters = _columnFilters.Select(kvp =>
            new GridFilterDescriptor(
                kvp.Key.Field ?? kvp.Key.Title,
                kvp.Value.Operator,
                kvp.Value.Value,
                kvp.Value.Value2)
        ).ToList(),
        CancellationToken = ct,
    };

    /// <summary>
    /// Recomputes grid data after query changes (search, filter, sort).
    /// For VirtualProvider: increments query generation and refreshes Virtualize component (Finding B-09).
    /// For ServerProvider: fetches new page from server.
    /// For Items: recomputes in-memory filtering/sorting with caching.
    /// </summary>
    private Task RecomputeAsync()
    {
        if (VirtualProvider != null)
        {
            return RefreshVirtualQueryAsync();
        }
        
        if (ServerProvider != null)
        {
            return RecomputeServerAsync();
        }
        
        RecomputeInMemory();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Refreshes the virtual query by incrementing query generation and calling Virtualize.RefreshDataAsync.
    /// This causes Virtualize to re-request data with the new search/filter/sort parameters.
    /// </summary>
    private async Task RefreshVirtualQueryAsync()
    {
        if (VirtualProvider == null || _disposed)
            return;

        InvalidateVirtualQuery();
        if (_virtualizeRef != null)
            await _virtualizeRef.RefreshDataAsync();

        if (!_disposed) StateHasChanged();
    }

    private void InvalidateVirtualQuery()
    {
        _virtualQueryGeneration++;
        _loadedVirtualItems.Clear();
        _exportError = null;
        var oldCts = _virtualQueryCts;
        _virtualQueryCts = new CancellationTokenSource();
        if (oldCts != null)
        {
            using (oldCts) oldCts.Cancel();
        }
    }

    private Task RetryAsync() => RecomputeAsync();

    // ─────────────────── sorting ───────────────────
    private async Task SortAsync(UiColumn<TItem> column)
    {
        var existing = _activeSorts.FindIndex(s => s.col == column);
        if (existing >= 0)
        {
            var (col, desc) = _activeSorts[existing];
            if (desc)
            {
                _activeSorts.RemoveAt(existing);
            }
            else
            {
                _activeSorts[existing] = (col, true);
            }
        }
        else
        {
            if (!MultiSort) _activeSorts.Clear();
            _activeSorts.Add((column, false));
        }
        _page = 1;
        await RecomputeAsync();
    }

    private string SortDir(UiColumn<TItem> c)
    {
        var idx = _activeSorts.FindIndex(s => s.col == c);
        if (idx < 0) return "none";
        return _activeSorts[idx].desc ? "desc" : "asc";
    }

    private string SortAria(UiColumn<TItem> c)
    {
        var idx = _activeSorts.FindIndex(s => s.col == c);
        if (idx < 0) return "none";
        return _activeSorts[idx].desc ? "descending" : "ascending";
    }

    // ─────────────────── search & filter ───────────────────
    private async Task OnSearchChangedAsync(string? text) { _search = text ?? ""; _page = 1; await RecomputeAsync(); }

    private void ToggleFilterPanel(UiColumn<TItem> col)
    {
        _openFilterCol = _openFilterCol == col ? null : col;
    }

    private string FilterPlaceholderText(GridFilterOperator op) =>
        op == GridFilterOperator.Between ? "From…" : FilterPlaceholder;

    private Task ApplyBoolFilterAsync(UiColumn<TItem> col, GridFilterOperator curOp) =>
        ApplyColumnFilterAsync(col, curOp == GridFilterOperator.IsFalse ? "false" : "true", curOp);

    public async Task ApplyColumnFilterAsync(UiColumn<TItem> col, string? value, GridFilterOperator? op = null, string? value2 = null)
    {
        var chosenOp = op ?? GetDefaultOperator(col.FilterType);
        if (string.IsNullOrWhiteSpace(value) && chosenOp != GridFilterOperator.IsTrue && chosenOp != GridFilterOperator.IsFalse)
        {
            _columnFilters.Remove(col);
        }
        else
        {
            _columnFilters[col] = new ColumnFilterState
            {
                Operator = chosenOp,
                Value = value ?? "",
                Value2 = value2
            };
        }
        _page = 1;
        await RecomputeAsync();
    }

    private async Task OnFilterOperatorChanged(UiColumn<TItem> col, string? opStr)
    {
        if (Enum.TryParse<GridFilterOperator>(opStr, out var op))
        {
            if (_columnFilters.TryGetValue(col, out var existing))
            {
                existing.Operator = op;
                await RecomputeAsync();
            }
            else
            {
                _columnFilters[col] = new ColumnFilterState
                {
                    Operator = op,
                    Value = "",
                    Value2 = null
                };
            }
        }
    }

    public sealed class ColumnFilterState
    {
        public GridFilterOperator Operator { get; set; }
        public string Value { get; set; } = "";
        public string? Value2 { get; set; }
    }

    private static string FormatFilterChip(ColumnFilterState f)
    {
        if (f.Operator == GridFilterOperator.Between)
            return $"{f.Value} .. {f.Value2}";
        if (f.Operator == GridFilterOperator.IsTrue)
            return "Yes";
        if (f.Operator == GridFilterOperator.IsFalse)
            return "No";
        return f.Value;
    }

    private static GridFilterOperator GetDefaultOperator(string? filterType) => filterType switch
    {
        "number" => GridFilterOperator.Equals,
        "date"   => GridFilterOperator.Equals,
        "bool"   => GridFilterOperator.IsTrue,
        _        => GridFilterOperator.Contains,
    };

    private static IReadOnlyList<GridFilterOperator> GetSupportedOperators(string? filterType) => filterType switch
    {
        "number" => new[]
        {
            GridFilterOperator.Equals,
            GridFilterOperator.NotEquals,
            GridFilterOperator.GreaterThan,
            GridFilterOperator.GreaterThanOrEqual,
            GridFilterOperator.LessThan,
            GridFilterOperator.LessThanOrEqual,
            GridFilterOperator.Between,
        },
        "date" => new[]
        {
            GridFilterOperator.Equals,
            GridFilterOperator.Before,
            GridFilterOperator.After,
            GridFilterOperator.Between,
        },
        "bool" => new[]
        {
            GridFilterOperator.IsTrue,
            GridFilterOperator.IsFalse,
        },
        _ => new[]
        {
            GridFilterOperator.Contains,
            GridFilterOperator.Equals,
            GridFilterOperator.StartsWith,
            GridFilterOperator.EndsWith,
        },
    };

    private static string OperatorLabel(GridFilterOperator op) => op switch
    {
        GridFilterOperator.Contains => "Contains",
        GridFilterOperator.Equals => "Equals",
        GridFilterOperator.NotEquals => "Not Equals",
        GridFilterOperator.StartsWith => "Starts With",
        GridFilterOperator.EndsWith => "Ends With",
        GridFilterOperator.GreaterThan => "> Greater than",
        GridFilterOperator.GreaterThanOrEqual => "≥ Greater or equal",
        GridFilterOperator.LessThan => "< Less than",
        GridFilterOperator.LessThanOrEqual => "≤ Less or equal",
        GridFilterOperator.Between => "Between",
        GridFilterOperator.Before => "Before",
        GridFilterOperator.After => "After",
        GridFilterOperator.IsTrue => "True",
        GridFilterOperator.IsFalse => "False",
        _ => op.ToString(),
    };

