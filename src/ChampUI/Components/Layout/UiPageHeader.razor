<div class="ui-page-header-wrap @Class">
    @if (Breadcrumbs is { Count: > 0 }) { <UiBreadcrumb Items="Breadcrumbs" /> }
    <div class="ui-page-header">
        <div class="ui-page-header__titles">
            <h1 class="ui-page-header__title">@Title @Badge</h1>
            @if (!string.IsNullOrEmpty(Subtitle)) { <p class="ui-page-header__subtitle">@Subtitle</p> }
        </div>
        @if (Actions != null) { <div class="ui-page-header__actions">@Actions</div> }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IReadOnlyList<BreadcrumbItem>? Breadcrumbs { get; set; }
    /// <summary>Content rendered next to the title (e.g. a status badge).</summary>
    [Parameter] public RenderFragment? Badge { get; set; }
    /// <summary>Buttons and controls aligned to the trailing edge.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
}
