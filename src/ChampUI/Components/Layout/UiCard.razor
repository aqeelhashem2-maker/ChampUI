<section class="ui-card @(Flush ? "ui-card--flush" : null) @(Interactive ? "ui-card--interactive" : null) @Class" @attributes="Attributes">
    @if (!string.IsNullOrEmpty(Title) || Actions != null)
    {
        <header class="ui-card__header">
            <div class="ui-card__titles">
                @if (!string.IsNullOrEmpty(Title)) { <h2 class="ui-card__title">@Title</h2> }
                @if (!string.IsNullOrEmpty(Subtitle)) { <p class="ui-card__subtitle">@Subtitle</p> }
            </div>
            @if (Actions != null) { <div class="ui-card__actions">@Actions</div> }
        </header>
    }
    <div class="ui-card__body @BodyClass">@ChildContent</div>
    @if (Footer != null) { <footer class="ui-card__footer">@Footer</footer> }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Removes body padding — ideal for tables and lists.</summary>
    [Parameter] public bool Flush { get; set; }
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }
}
