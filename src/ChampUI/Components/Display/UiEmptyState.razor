<div class="ui-empty @Class" role="status">
    <div class="ui-empty__icon"><UiIcon Name="@Icon" Size="26" /></div>
    <div class="ui-empty__title">@Title</div>
    @if (!string.IsNullOrEmpty(Description)) { <p class="ui-empty__text">@Description</p> }
    @ChildContent
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Optional actions rendered under the description.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
