@if (!_dismissed)
{
    <div class="ui-alert ui-alert--@Variant.Css() @Class" role="@(Variant is UiVariant.Danger or UiVariant.Warning ? "alert" : "status")">
        <span class="ui-alert__icon"><UiIcon Name="@IconName" Size="20" /></span>
        <div class="ui-alert__body">
            @if (!string.IsNullOrEmpty(Title)) { <div class="ui-alert__title">@Title</div> }
            @ChildContent
        </div>
        @if (Dismissible)
        {
            <button type="button" class="ui-alert__close" aria-label="@DismissLabel" @onclick="DismissAsync"><UiIcon Name="x" Size="16" /></button>
        }
    </div>
}

@code {
    private bool _dismissed;

    [Parameter] public UiVariant Variant { get; set; } = UiVariant.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissLabel { get; set; } = "Dismiss";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string IconName => Variant switch
    {
        UiVariant.Success => "check-circle",
        UiVariant.Warning => "alert",
        UiVariant.Danger => "x-circle",
        _ => "info"
    };

    private async Task DismissAsync() { _dismissed = true; await OnDismiss.InvokeAsync(); }
}
