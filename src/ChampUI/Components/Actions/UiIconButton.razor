<button type="button" class="ui-iconbtn @(Outline ? "ui-iconbtn--outline" : null) @(Primary ? "ui-iconbtn--primary" : null) @(Small ? "ui-iconbtn--sm" : null) @Class"
        aria-label="@Label" title="@Label" disabled="@Disabled" @onclick="OnClick" @attributes="Attributes">
    <UiIcon Name="@Icon" Size="@(Small ? 16 : 19)" />
    @if (Indicator) { <span class="ui-iconbtn__dot" aria-hidden="true"></span> }
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    /// <summary>Accessible name (also used as the native tooltip).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Outline { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Shows a small notification dot.</summary>
    [Parameter] public bool Indicator { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }
}
