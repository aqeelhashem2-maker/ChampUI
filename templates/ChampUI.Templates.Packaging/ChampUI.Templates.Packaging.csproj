<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SadeemSystems.ChampUI.Templates</PackageId>
    <Version>0.1.2</Version>
    <Authors>Sadeem Systems</Authors>
    <Company>Sadeem Systems</Company>
    <Description>A Blazor Interactive Server dashboard project template built with ChampUI.</Description>
    <PackageTags>dotnet-new;blazor;dashboard;champui</PackageTags>
    <PackageType>Template</PackageType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- A local package can include uncommitted template changes. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../ChampUI.Dashboard/README.md" Pack="true" PackagePath="/" />
    <Content Include="../ChampUI.Dashboard/**/*"
             Exclude="../ChampUI.Dashboard/**/[Bb]in/**;../ChampUI.Dashboard/**/[Oo]bj/**;../ChampUI.Dashboard/**/.git/**;../ChampUI.Dashboard/**/.vs/**;../ChampUI.Dashboard/**/.idea/**;../ChampUI.Dashboard/**/.DS_Store;../ChampUI.Dashboard/**/*.user;../ChampUI.Dashboard/**/*.filelist;../ChampUI.Dashboard/**/TestResults/**;../ChampUI.Dashboard/**/NuGet.Config;../ChampUI.Dashboard/**/appsettings.Local.json;../ChampUI.Dashboard/**/.env*"
             Pack="true" PackagePath="content/ChampUI.Dashboard/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
